HOST=127.0.0.1
PORT=4173
# For LAN access, set HOST=0.0.0.0, enable NOVI_AUTH_REQUIRED, and set NOVI_APP_ORIGIN to the server's LAN URL.
# Set an absolute path for a persistent deployment volume.
NOVI_DATA_FILE=./data/novi.json
NOVI_STORAGE=json
# Production release-check requires postgres; json is for local desktop/single-instance use.
NOVI_PG_URL=
NOVI_PG_POOL_MAX=10
# Production requires pgvector with a 24-dimensional native index; JSONB fallback is for migration/development only.
NOVI_REQUIRE_NATIVE_VECTOR=false
# Production raw-document backend: set an S3-compatible HTTP prefix or a private filesystem directory.
NOVI_OBJECT_STORE_URL=
NOVI_OBJECT_STORE_DIR=
NOVI_OBJECT_STORE_TOKEN=
# Optional AWS SigV4 credentials for real S3-compatible endpoints. Leave unset for a trusted Bearer HTTP gateway.
NOVI_OBJECT_STORE_ACCESS_KEY=
NOVI_OBJECT_STORE_SECRET_KEY=
NOVI_OBJECT_STORE_REGION=us-east-1
NOVI_OBJECT_STORE_SERVICE=s3
# Durable object/graph projection worker interval (milliseconds; retries use exponential backoff).
NOVI_PROJECTION_INTERVAL_MS=5000
# Production knowledge graph backend: Neo4j HTTP transaction endpoint.
NOVI_GRAPH_URL=
NOVI_GRAPH_USER=
NOVI_GRAPH_PASSWORD=
NOVI_GRAPH_TOKEN=
NOVI_AUTH_REQUIRED=false
NOVI_COOKIE_SECURE=false
# Set true only when a trusted reverse proxy sanitizes X-Forwarded-Proto.
NOVI_TRUST_PROXY=false
NOVI_APP_ORIGIN=http://127.0.0.1:4173
# Optional OIDC SSO (Authorization Code + PKCE-ready provider boundary).
NOVI_OIDC_ISSUER=
NOVI_OIDC_CLIENT_ID=
NOVI_OIDC_CLIENT_SECRET=
NOVI_OIDC_REDIRECT_URI=http://127.0.0.1:4173/api/auth/oidc/callback
NOVI_OIDC_SCOPE=openid profile email
NOVI_OIDC_ALLOW_EMAIL_LINK=false
# Web-configured tenant providers take precedence over this legacy OpenAI-compatible gateway.
# Leave both Web and legacy configuration unset for deterministic offline generation.
NOVI_LLM_BASE_URL=https://api.openai.com/v1
NOVI_LLM_API_KEY=
NOVI_LLM_MODEL=
# First meaningful model token timeout (milliseconds, clamped to 1000..120000).
NOVI_LLM_TIMEOUT_MS=90000
# Maximum idle time between meaningful streamed model chunks (milliseconds, clamped to 5000..120000).
NOVI_LLM_STREAM_IDLE_TIMEOUT_MS=30000
# Maximum wall-clock time for one streamed LangGraph stage (milliseconds, clamped to 60000..1800000).
NOVI_LLM_STAGE_MAX_MS=600000
# Maximum output tokens for each LangGraph stage (clamped to 512..32768).
NOVI_LLM_MAX_OUTPUT_TOKENS=8192
# Required in production before Web provider credentials can be stored. Use a stable secret of at least 32 characters.
NOVI_CONFIG_ENCRYPTION_KEY=
# Comma-separated hostname allowlist for non-loopback custom OpenAI-compatible endpoints.
NOVI_LLM_ALLOWED_HOSTS=
# Comma-separated HTTPS hostname allowlist for custom Agent HTTP tools.
NOVI_TOOL_ALLOWED_HOSTS=
# Per-call custom Agent tool timeout in milliseconds (clamped to 1000..30000).
NOVI_TOOL_TIMEOUT_MS=10000
# Enables local Agent terminal/exec tools. Keep false unless the server host is an approved execution environment.
NOVI_AGENT_EXEC_ENABLED=false
# Comma-separated executable basename allowlist used by terminal command segments and direct exec.
NOVI_AGENT_EXEC_ALLOWED=pwd,ls,find,grep,rg,cat,head,tail,wc,sort,uniq,cut,sed,awk,printf,echo,node,npm,npx,git
# Optional payment provider boundary. The provider must return { checkoutUrl }.
NOVI_PAYMENT_CHECKOUT_URL=
NOVI_PAYMENT_API_KEY=
NOVI_PAYMENT_WEBHOOK_SECRET=
# Optional GitHub API token for higher source-search rate limits.
GITHUB_TOKEN=
# Optional Semantic Scholar token for higher request limits.
SEMANTIC_SCHOLAR_API_KEY=
# Optional YouTube Data API v3 key for video sources.
YOUTUBE_API_KEY=
# Enable live OpenAlex, arXiv, Wikipedia, Crossref, GitHub and optional extended retrieval.
NOVI_LIVE_SOURCES=false
# Verify concrete live-source URLs before mapping them to claims (default true when live sources are enabled).
NOVI_VERIFY_SOURCES=true
# Optional isolated Browser Agent HTTP worker for JavaScript-rendered imports. Production remote endpoints require HTTPS and a bearer token.
NOVI_BROWSER_AGENT_URL=
NOVI_BROWSER_AGENT_TOKEN=
NOVI_BROWSER_AGENT_TIMEOUT_MS=15000
# Optional MCP Streamable HTTP server exposing a source-search tool with { query, limit } input and structured sources output.
NOVI_MCP_SOURCE_URL=
NOVI_MCP_SOURCE_TOKEN=
NOVI_MCP_SOURCE_TOOL=search
NOVI_MCP_SOURCE_TIMEOUT_MS=15000
# Tenant-configured Agent MCP Streamable HTTP servers must use one of these remote hostnames.
NOVI_MCP_ALLOWED_HOSTS=
# Agent MCP initialize/list/call timeout in milliseconds (clamped to 1000..30000).
NOVI_MCP_TIMEOUT_MS=10000
# Scheduled daily/weekly source refresh worker (set false for desktop-only mode).
NOVI_REFRESH_WORKER=true
NOVI_REFRESH_INTERVAL_MS=300000
# Queue consumer for async generation; multiple instances may safely compete for queued jobs.
NOVI_JOB_WORKER=true
NOVI_JOB_INTERVAL_MS=1000
# Optional Chromium binary used by `npm run browser-smoke`.
CHROMIUM_BIN=chromium
